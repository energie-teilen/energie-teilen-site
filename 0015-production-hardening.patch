+    const body = readFileSync(join(ROOT, "client", "src", "pages", "NotFound.tsx"), "utf8");
+    expect(body).not.toMatch(/Page Not Found|Go Home|doesn't exist/);
+    expect(body).toMatch(/<Link/);
+    expect(body).toMatch(/Header|Footer/);
+  });
