diff --git a/client/src/fonts.css b/client/src/fonts.css
new file mode 100644
index 0000000..3564810
--- /dev/null
+++ b/client/src/fonts.css
@@ -0,0 +1,39 @@
+/*
+ * Self-hosted web fonts.
+ *
+ * The font files live in client/public/fonts and are served from this origin.
+ * They are NOT committed as binaries; `pnpm fonts:fetch` downloads them and
+ * writes them there, and the build works with or without them because every
+ * family declares a full fallback stack.
+ *
+ * Why not a font CDN: loading a stylesheet from one transmits the visitor's IP
+ * address to that provider on first paint, before any consent can be given,
+ * and puts a cross-origin request on the critical rendering path. Neither is
+ * acceptable for a German B2B audience whose own compliance teams will check.
+ *
+ * `font-display: swap` renders the fallback immediately and swaps when the
+ * file arrives, so a missing file degrades to readable text rather than to
+ * invisible text.
+ */
+
+@font-face {
+  font-family: "Manrope";
+  font-style: normal;
+  font-weight: 500 800;
+  font-display: swap;
+  src: url("/fonts/manrope-variable.woff2") format("woff2-variations");
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
+    U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
+    U+2212, U+2215, U+FEFF, U+FFFD;
+}
+
+@font-face {
+  font-family: "IBM Plex Sans";
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+  src: url("/fonts/ibm-plex-sans-variable.woff2") format("woff2-variations");
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
+    U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
+    U+2212, U+2215, U+FEFF, U+FFFD;
+}
