@@ -0,0 +1,179 @@
+#!/usr/bin/env node
+/**
+ * scripts/doctor.mjs — the go-live gate.
+ *
+ * Nine patches of funnel work are deployed and the site has taken zero euros,
+ * because /api/pilot-checkout returns 503 to every visitor until Stripe is
+ * configured. That is not a code problem, so no amount of code fixes it. This
+ * turns the remaining gap into a checklist that says what is missing, what it
+ * costs while it stays missing, and exactly what to do about it.
+ *
+ * Reads only /api/health, which reports presence of configuration and never a
+ * secret value.
+ *
+ *   pnpm doctor                      # production
+ *   pnpm doctor http://localhost:3000
+ */
+
+const DEFAULT_URL = "https://energie-teilen-site.vercel.app";
+const base = (process.argv[2] || DEFAULT_URL).replace(/\/+$/, "");
+
+const c = {
+  reset: "[0m",
+  bold: "[1m",
+  dim: "[2m",
+  red: "[31m",
+  green: "[32m",
+  yellow: "[33m",
+  cyan: "[36m",
+};
+
+/**
+ * Ordered by what it costs to leave broken, not by where it sits in the stack.
+ * `blocking` means: money cannot be taken while this is false.
+ */
+const CHECKS = [
+  {
+    key: "stripe",
+    blocking: true,
+    label: "Stripe secret key",
+    impact: "Checkout returns 503 to every visitor. No payment is possible.",
+    fix: "Set STRIPE_SECRET_KEY (Vercel → Settings → Environment Variables).",
+  },
+  {
+    key: "prices",
+    blocking: true,
+    label: "Stripe price IDs (3 tiers)",
+    impact: "The tier the visitor selects cannot be priced, so checkout fails.",
+    fix: "Create three one-time Products in Stripe, then set STRIPE_PRICE_ET_ELIGIBILITY, _STRUCTURING, _MANDATE.",
+    nested: true,
+  },
+  {
+    key: "appUrl",
+    blocking: true,
+    label: "APP_URL",
+    impact:
+      "Stripe redirects back to localhost after payment, so the confirmation screen never renders.",
+    fix: `Set APP_URL=${DEFAULT_URL}`,
+    isString: true,
+  },
+  {
+    key: "stripeWebhook",
+    blocking: true,
+    label: "Stripe webhook secret",
+    impact:
+      "Payments succeed but nothing is recorded: no ledger entry, no confirmation, no order to fulfil.",
+    fix: `Add an endpoint at ${DEFAULT_URL}/api/stripe/webhook for checkout.session.completed AND checkout.session.async_payment_succeeded, then set STRIPE_WEBHOOK_SECRET.`,
+  },
+  {
+    key: "resend",
+    blocking: false,
+    label: "Resend API key",
+    impact: "The customer pays and receives nothing from you. Refund risk.",
+    fix: "Set RESEND_API_KEY and RESEND_FROM_EMAIL on a domain you control.",
+  },
+  {
+    key: "customerConfirmation",
+    blocking: false,
+    label: "Customer confirmation reply-to",
+    impact: "The confirmation email has no address for the customer to send project data to.",
+    fix: "Set ET_CUSTOMER_REPLY_TO (or LEAD_NOTIFICATION_EMAIL) to a domain address.",
+  },
+  {
+    key: "durableOrders",
+    blocking: false,
+    label: "Durable order ledger",
+    impact:
+      "A paid order exists only in Stripe and one email. It cannot be listed, tracked or chased.",
+    fix: "Create a free Upstash Redis DB, set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.",
+  },
+  {
+    key: "adminApi",
+    blocking: false,
+    label: "Admin API",
+    impact: "No way to see open orders, what they are worth, or what is overdue.",
+    fix: "Set ADMIN_API_TOKEN to at least 32 random characters: openssl rand -hex 32",
+  },
+];
+
+function evaluate(config, check) {
+  if (check.nested) {
+    const p = config.prices ?? {};
+    const vals = Object.values(p);
+    return vals.length > 0 && vals.every(Boolean);
+  }
+  if (check.isString) {
+    const v = config[check.key];
+    return typeof v === "string" && v.length > 0 && v !== "(unset)";
+  }
+  return config[check.key] === true;
+}
+
+async function main() {
+  process.stdout.write(`${c.dim}Checking ${base}/api/health …${c.reset}\n\n`);
+
+  let config;
+  try {
+    const res = await fetch(`${base}/api/health?cb=${Date.now()}`, {
+      headers: { "cache-control": "no-cache" },
+    });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    config = (await res.json()).config ?? {};
+  } catch (err) {
+    process.stdout.write(`${c.red}${c.bold}Could not reach the site.${c.reset} ${String(err)}\n`);
+    process.stdout.write(`${c.dim}Is it deployed? Try: npx vercel --prod${c.reset}\n`);
+    process.exit(2);
+  }
+
+  const results = CHECKS.map((check) => ({ ...check, ok: evaluate(config, check) }));
+  const blockers = results.filter((r) => r.blocking && !r.ok);
+  const degraded = results.filter((r) => !r.blocking && !r.ok);
+
+  for (const r of results) {
+    const mark = r.ok ? `${c.green}✓${c.reset}` : r.blocking ? `${c.red}✗${c.reset}` : `${c.yellow}!${c.reset}`;
+    process.stdout.write(`  ${mark} ${r.label}\n`);
+  }
+
+  process.stdout.write("\n");
+
+  if (blockers.length > 0) {
+    process.stdout.write(
+      `${c.red}${c.bold}REVENUE BLOCKED${c.reset} — ${blockers.length} of ${
+        results.filter((r) => r.blocking).length
+      } payment prerequisites are missing.\n` +
+        `${c.dim}The funnel is deployed and cannot take a single euro until these are set.${c.reset}\n\n`,
+    );
+    blockers.forEach((r, i) => {
+      process.stdout.write(`${c.bold}${i + 1}. ${r.label}${c.reset}\n`);
+      process.stdout.write(`   ${c.dim}Costs you:${c.reset} ${r.impact}\n`);
+      process.stdout.write(`   ${c.cyan}Fix:${c.reset} ${r.fix}\n\n`);
+    });
+  } else {
+    process.stdout.write(`${c.green}${c.bold}Payment path is configured.${c.reset}\n\n`);
+    process.stdout.write(`${c.dim}Prove it end to end before trusting it:${c.reset}\n`);
+    process.stdout.write(`  stripe listen --forward-to ${base}/api/stripe/webhook\n`);
+    process.stdout.write(`  ${c.dim}then buy a tier with test card 4242 4242 4242 4242 and confirm:${c.reset}\n`);
+    process.stdout.write(`  ${c.dim}confirmation screen → customer email → order in /api/admin/orders${c.reset}\n\n`);
+  }
+
+  if (degraded.length > 0) {
+    process.stdout.write(
+      `${c.yellow}${c.bold}DEGRADED${c.reset} — payment would work, fulfilment would not.\n\n`,
+    );
+    degraded.forEach((r) => {
+      process.stdout.write(`${c.bold}· ${r.label}${c.reset}\n`);
+      process.stdout.write(`   ${c.dim}Costs you:${c.reset} ${r.impact}\n`);
+      process.stdout.write(`   ${c.cyan}Fix:${c.reset} ${r.fix}\n\n`);
+    });
+  }
+
+  if (blockers.length === 0 && degraded.length === 0) {
+    process.stdout.write(`${c.green}${c.bold}All clear. Nothing between you and revenue but customers.${c.reset}\n`);
+  }
+
+  // Non-zero only for revenue blockers: degraded is a warning, not a failure,
+  // so this stays usable in CI without turning fulfilment gaps into red builds.
+  process.exit(blockers.length > 0 ? 1 : 0);
+}
+
+main();
