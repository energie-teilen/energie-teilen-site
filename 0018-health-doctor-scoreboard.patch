+    evaluate: ({ env }) =>
+      checkPrefix(env[envVar], /^price_[A-Za-z0-9]+$/, "Gesetzt, aber keine Stripe-Preis-ID."),
+  };
+}
+
+/**
+ * Ordered by what it costs to leave broken, not by where it sits in the stack:
