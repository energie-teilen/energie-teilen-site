+      if (apiKeysConfigured) return PRESENT;
+      if (typeof env.ET_API_KEYS === "string" && env.ET_API_KEYS.trim().length > 0) {
+        return unusable("Gesetzt, aber ohne gültigen Eintrag der Form label:sha256-hash.");
