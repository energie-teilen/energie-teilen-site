+  for (const m of messages) {
+    const unh: Segment = { tag: "UNH", elements: [m.reference, m.identifier] };
+    // UNH + body + UNT.
+    const count = m.segments.length + 2;
+    const unt: Segment = { tag: "UNT", elements: [String(count), m.reference] };
