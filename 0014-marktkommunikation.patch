+      const actual = i - open.startIndex + 1;
+      if (declared !== actual) {
+        findings.push({
+          code: "unt_count_mismatch",
+          message: `UNT weist ${declared} Segmente aus, tatsächlich sind es ${actual}.`,
+        });
+      }
