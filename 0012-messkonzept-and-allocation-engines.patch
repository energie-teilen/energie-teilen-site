+              {/* The allocation itself is a calculation, not a wire. */}
+              <Wire
+                d={`M ${plant.x + plant.w / 2} ${plant.y + plant.h / 2} C ${W / 2} ${plant.y + 120}, ${W / 2} ${plant.y + 120}, ${W / 2} ${252}`}
