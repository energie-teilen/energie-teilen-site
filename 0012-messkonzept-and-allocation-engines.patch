+  const drawn = Math.min(units, MAX_DRAWN_UNITS);
+  const boxW = 82;
+  const gap = 14;
+  const totalW = drawn * boxW + (drawn - 1) * gap;
+  const startX = (W - totalW) / 2;
+
+  return (
+    <g>
